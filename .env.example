# Browser-safe Supabase credentials used by authenticated app sessions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase credentials used by the public waitlist. Never expose
# the service-role key through a NEXT_PUBLIC_ variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public canonical URL used in metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
